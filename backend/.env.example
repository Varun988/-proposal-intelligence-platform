# Application
APP_NAME=Proposal Intelligence Platform
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1

# LLM
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=

# Agent limits
MAX_AGENT_STEPS=12
MAX_AGENT_RETRIES=2
MAX_LLM_CALLS_PER_ASSESSMENT=20

# Local storage
DATABASE_URL=sqlite:///./proposal_intelligence.db
UPLOAD_DIRECTORY=../data/uploads
INDEX_DIRECTORY=../data/indexes
